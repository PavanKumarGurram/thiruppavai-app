[
 {
  "n": 1,
  "title": "மார்கழித் திங்கள்",
  "titleEn": "The Vow Begins",
  "raga": "Nattai",
  "tamil": [
   "மார்கழித் திங்கள் மதி நிறைந்த நன்னாளால்",
   "நீராடப் போதுவீர் போதுமினோ நேரிழையீர்",
   "சீர் மல்கும் ஆய்ப்பாடிச் செல்வச் சிறுமீர்காள்",
   "கூர் வேல் கொடுந்தொழிலன் நந்தகோபன் குமரன்",
   "ஏரார்ந்த கண்ணி யசோதை இளஞ்சிங்கம்",
   "கார்மேனிச் செங்கண் கதிர் மதியம் போல் முகத்தான்",
   "நாராயணனே நமக்கே பறை தருவான்",
   "பாரோர் புகழப் படிந்து ஏலோர் எம்பாவாய்"
  ],
  "translit": [
   "maarkazhith thinggaL madhi niRaindha nannaaLaal",
   "niiraaTap poodhuviir poodhuminoo neerizhaiyiir",
   "siir malkum aayppaaTich selvach siRumiirkaaL",
   "kuur veel koTundhozhilan nandhagooban kumaran",
   "eeraarndha kaNNi yasoodhai iLanjchinggam",
   "kaarmeenich senggaN kadhir madhiyam pool mugaththaan",
   "naaraayaNanee namakkee paRai tharuvaan",
   "paaroor pugazhap paTindhu eeloor embaavaay"
  ],
  "meaning": "On this auspicious Margazhi morning, the wealthy cowherd girls are called to bathe and join the vow — to sing of Narayana, the son of Nandagopa and the lion-cub of the beautiful-eyed Yashoda, whose face glows like the sun and moon."
 },
 {
  "n": 2,
  "title": "வையத்து வாழ்வீர்காள்",
  "titleEn": "Rules of the Vow",
  "raga": "Gowla",
  "tamil": [
   "வையத்து வாழ்வீர்காள் நாமும் நம் பாவைக்குச்",
   "செய்யும் கிரிசைகள் கேளீரோ பாற்கடலுள்",
   "பையத் துயின்ற பரமனடி பாடி",
   "நெய்யுண்ணோம் பாலுண்ணோம் நாட்காலே நீராடி",
   "மையிட்டு எழுதோம் மலரிட்டு நாம் முடியோம்",
   "செய்யாதன செய்யோம் தீக்குறளைச் சென்றோதோம்",
   "ஐயமும் பிச்சையும் ஆந்தனையும் கைகாட்டி",
   "உய்யுமாறு எண்ணி உகந்து ஏலோர் எம்பாவாய்"
  ],
  "translit": [
   "vaiyaththu vaazhviirkaaL naamum nam paavaikkuch",
   "seyyum kirisaigaL keeLiiroo paaRkaTaluL",
   "paiyath thuyinRa paramanaTi paaTi",
   "neyyuNNoom paaluNNoom naaTkaalee niiraaTi",
   "maiyiTTu ezhudhoom malariTTu naam muTiyoom",
   "seyyaadhana seyyoom thiikkuRaLaich senRoodhoom",
   "aiyamum pichchaiyum aandhanaiyum kaigaaTTi",
   "uyyumaaRu eNNi ugandhu eeloor embaavaay"
  ],
  "meaning": "Hear the rules of our vow, all who live in this world: we will sing of the Lord who sleeps on the milky ocean, eat no ghee or milk, wear no flowers, do no wrong, give alms generously, and think only of rising higher."
 },
 {
  "n": 3,
  "title": "ஓங்கி உலகளந்த",
  "titleEn": "The World-Measurer",
  "raga": "Arabhi",
  "tamil": [
   "ஓங்கி உலகளந்த உத்தமன் பேர் பாடி",
   "நாங்கள் நம் பாவைக்குச் சாற்றி நீராடினால்",
   "தீங்கின்றி நாடெல்லாம் திங்கள் மும்மாரி பெய்து",
   "ஓங்கு பெருஞ்செந்நெல் ஊடு கயலுகள",
   "பூங்குவளைப் போதில் பொறிவண்டு கண்படுப்ப",
   "தேங்காதே புக்கிருந்து சீர்த்த முலை பற்றி",
   "வாங்கக் குடம் நிறைக்கும் வள்ளல் பெரும்பசுக்கள்",
   "நீங்காத செல்வம் நிறைந்து ஏலோர் எம்பாவாய்"
  ],
  "translit": [
   "oonggi ulagaLandha uththaman peer paaTi",
   "naanggaL nam paavaikkuch saaRRi niiraaTinaal",
   "thiingginRi naaTellaam thinggaL mummaari peythu",
   "oonggu perunjchennel uuTu kayalugaLa",
   "puungguvaLaip poodhil poRivaNTu kaNbaTuppa",
   "theenggaadhee pukkirundhu siirththa mulai paRRi",
   "vaanggak kuTam niRaikkum vaLLal perumbasukkaL",
   "niinggaadha selvam niRaindhu eeloor embaavaay"
  ],
  "meaning": "If we sing of the Lord who strode across the worlds and bathe in this vow, the rains will fall three times a month, the tall red paddy will flourish with fat kayal fish among the blossoms, and our prosperity will never leave."
 },
 {
  "n": 4,
  "title": "ஆழி மழைக்கண்ணா",
  "titleEn": "Lord of the Rains",
  "raga": "Varali",
  "tamil": [
   "ஆழி மழைக்கண்ணா ஒன்று நீ கைகரவேல்",
   "ஆழியுள் புக்கு முகந்து கொடார்த்தேறி",
   "ஊழி முதல்வன் உருவம்போல் மெய் கறுத்துப்",
   "பாழியந் தோளுடைப் பத்மநாபன் கையில்",
   "ஆழிபோல் மின்னி வலம்புரிபோல் நின்றதிர்ந்து",
   "தாழாதே சார்ங்கம் உதைத்த சரமழைபோல்",
   "வாழ உலகினில் பெய்திடாய் நாங்களும்",
   "மார்கழி நீராட மகிழ்ந்து ஏலோர் எம்பாவாய்"
  ],
  "translit": [
   "aazhi mazhaikkaNNaa onRu nii kaigaraveel",
   "aazhiyuL pukku mugandhu koTaarththeeRi",
   "uuzhi mudhalvan uruvambool mey kaRuththup",
   "paazhiyan thooLuTaip pathmanaaban kaiyil",
   "aazhibool minni valamburibool ninRadhirndhu",
   "thaazhaadhee saarnggam udhaiththa saramazhaibool",
   "vaazha ulaginil peythiTaay naanggaLum",
   "maarkazhi niiraaTa magizhndhu eeloor embaavaay"
  ],
  "meaning": "O lord of the rains, draw water from the ocean and rise dark as the Primal Lord, flash like the discus in Vishnu's hand and thunder like His conch — then pour down on the world so we may bathe joyfully in Margazhi."
 },
 {
  "n": 5,
  "title": "மாயனை",
  "titleEn": "The Dark Lord of Mathura",
  "raga": "Sri",
  "tamil": [
   "மாயனை மன்னு வடமதுரை மைந்தனைத்",
   "தூய பெருநீர் யமுனைத் துறைவனை",
   "ஆயர் குலத்தினில் தோன்றும் அணிவிளக்கைத்",
   "தாயைக் குடல்விளக்கம் செய்த தாமோதரனைத்",
   "தூயோமாய் வந்து நாம் தூமலர் தூவித் தொழுது",
   "வாயினால் பாடி மனத்தினால் சிந்திக்கப்",
   "போய பிழையும் புகுதருவான் நின்றனவும்",
   "தீயினில் தூசாகும் செப்பு ஏலோர் எம்பாவாய்"
  ],
  "translit": [
   "maayanai mannu vaTamadhurai maindhanaith",
   "thuuya peruniir yamunaith thuRaivanai",
   "aayar kulaththinil thoonRum aNiviLakkaith",
   "thaayaik kuTalviLakkam seytha thaamoodharanaith",
   "thuuyoomaay vandhu naam thuumalar thuuvith thozhudhu",
   "vaayinaal paaTi manaththinaal sindhikkap",
   "pooya pizhaiyum pugudharuvaan ninRanavum",
   "thiiyinil thuusaagum seppu eeloor embaavaay"
  ],
  "meaning": "Meditating on Krishna — the wonder of Mathura, the lord of the Yamuna's banks, the lamp of the cowherd clan whom Yashoda raised as the lamp of her womb — and worshipping Him with pure hearts, all our past and future sins will burn away like cotton in fire."
 },
 {
  "n": 6,
  "title": "புள்ளும் சிலம்பின காண்",
  "titleEn": "Dawn Has Come",
  "raga": "Sankarabharanam",
  "tamil": [
   "புள்ளும் சிலம்பின காண் புள்ளரையன் கோயிலில்",
   "வெள்ளை விளிசங்கின் பேரரவம் கேட்டிலையோ",
   "பிள்ளாய் எழுந்திராய் பேய்முலை நஞ்சுண்டு",
   "கள்ளச் சகடம் கலக்கழியக் காலோச்சி",
   "வெள்ளத்து அரவில் துயில் அமர்ந்த வித்தினை",
   "உள்ளத்துக் கொண்டு முனிவர்களும் யோகிகளும்",
   "மெள்ள எழுந்து அரி என்ற பேரரவம்",
   "உள்ளம் புகுந்து குளிர்ந்து ஏலோர் எம்பாவாய்"
  ],
  "translit": [
   "puLLum silambina kaaN puLLaraiyan kooyilil",
   "veLLai viLisanggin peeraravam keeTTilaiyoo",
   "piLLaay ezhundhiraay peeymulai nanjchuNTu",
   "kaLLach sagaTam kalakkazhiyak kaaloochchi",
   "veLLaththu aravil thuyil amarndha viththinai",
   "uLLaththuk koNTu munivarkaLum yoogigaLum",
   "meLLa ezhundhu ari enRa peeraravam",
   "uLLam pugundhu kuLirndhu eeloor embaavaay"
  ],
  "meaning": "The birds are chirping, the temple conch resounds — wake up, girl! The sages and yogis have risen meditating on Vishnu who sleeps on the serpent in the ocean of milk. Our hearts have melted into Him; come, let us be cooled in His name."
 },
 {
  "n": 7,
  "title": "கீசு கீசென்று",
  "titleEn": "Wake, Lazy Girl",
  "raga": "Bhairavi",
  "tamil": [
   "கீசு கீசென்று எங்கும் ஆனைச்சாத்தன் கலந்து",
   "பேசின பேச்சரவம் கேட்டிலையோ பேய்ப்பெண்ணே",
   "காசும் பிறப்பும் கலகலப்பக் கைபேர்த்து",
   "வாச நறுங்குழல் ஆய்ச்சியர் மத்தினால்",
   "ஓசை படுத்த தயிரரவம் கேட்டிலையோ",
   "நாயகப் பெண்பிள்ளாய் நாராயணன் மூர்த்தி",
   "கேசவனைப் பாடவும் நீ கேட்டே கிடத்தியோ",
   "தேசம் உடையாய் திறவேலோர் எம்பாவாய்"
  ],
  "translit": [
   "kiisu kiisenRu enggum aanaichchaaththan kalandhu",
   "peesina peechcharavam keeTTilaiyoo peeyppeNNee",
   "kaasum piRappum kalagalappak kaibeerththu",
   "vaasa naRungguzhal aaychchiyar maththinaal",
   "oosai paTuththa thayiraravam keeTTilaiyoo",
   "naayagap peNbiLLaay naaraayaNan muurththi",
   "keesavanaip paaTavum nii keeTTee kiTaththiyoo",
   "theesam uTaiyaay thiRaveeloor embaavaay"
  ],
  "meaning": "The chattering of birds everywhere, the clatter of churns — can you not hear it, lazy girl? The cowherd women are churning curd, making the noise ring out. Wake, bride of our Lord, and sing of Narayana and Kesava."
 },
 {
  "n": 8,
  "title": "கீழ்வானம் வெள்ளென்று",
  "titleEn": "The Morning Call",
  "raga": "Dhanashri",
  "tamil": [
   "கீழ்வானம் வெள்ளென்று எருமை சிறுவீடு",
   "மேய்வான் பரந்தன காண் மிக்குள்ள பிள்ளைகளும்",
   "போவான் போகின்றாரைப் போகாமல் காத்து உன்னைக்",
   "கூவுவான் வந்து நின்றோம் கோதுகலம் உடைய",
   "பாவாய் எழுந்திராய் பாடிப் பறைகொண்டு",
   "மாவாய் பிளந்தானை மல்லரை மாட்டிய",
   "தேவாதி தேவனைச் சென்று நாம் சேவித்தால்",
   "ஆவாவென்று ஆராய்ந்து அருளேலோர் எம்பாவாய்"
  ],
  "translit": [
   "kiizhvaanam veLLenRu erumai siRuviiTu",
   "meeyvaan parandhana kaaN mikkuLLa piLLaigaLum",
   "poovaan pooginRaaraip poogaamal kaaththu unnaik",
   "kuuvuvaan vandhu ninRoom koodhugalam uTaiya",
   "paavaay ezhundhiraay paaTip paRaigoNTu",
   "maavaay piLandhaanai mallarai maaTTiya",
   "theevaadhi theevanaich senRu naam seeviththaal",
   "aavaavenRu aaraayndhu aruLeeloor embaavaay"
  ],
  "meaning": "The eastern sky reddens and the buffaloes wander out to graze; the other girls have gone ahead without waiting. We have come calling you with joy — wake, girl! Let us sing of Him who tore open the demon's mouth and crushed the wrestlers, and be graced."
 },
 {
  "n": 9,
  "title": "தூமணி மாடத்து",
  "titleEn": "The Girl in the Mansion",
  "raga": "Hameer Kalyani",
  "tamil": [
   "தூமணி மாடத்துச் சுற்றும் விளக்கெரியத்",
   "தூபம் கமழத் துயில் அணைமேல் கண்வளரும்",
   "மாமான் மகளே மணிக்கதவம் தாள்திறவாய்",
   "மாமீர் அவளை எழுப்பீரோ உம்மகள்தான்",
   "ஊமையோ அன்றிச் செவிடோ அனந்தலோ",
   "ஏமப் பெருந்துயில் மந்திரப் பட்டாளோ",
   "மாமாயன் மாதவன் வைகுந்தன் என்றென்று",
   "நாமம் பலவும் நவின்று ஏலோர் எம்பாவாய்"
  ],
  "translit": [
   "thuumaNi maaTaththuch suRRum viLakkeriyath",
   "thuubam kamazhath thuyil aNaimeel kaNvaLarum",
   "maamaan magaLee maNikkadhavam thaaLthiRavaay",
   "maamiir avaLai ezhuppiiroo ummagaLthaan",
   "uumaiyoo anRich seviToo anandhaloo",
   "eemap perundhuyil mandhirap paTTaaLoo",
   "maamaayan maadhavan vaigundhan enRenRu",
   "naamam palavum navinRu eeloor embaavaay"
  ],
  "meaning": "O daughter of our uncle, asleep in your gem-lit mansion with lamps all around and incense in the air — open your jeweled door! Wake her, aunt! We sing His many names — the great Enchanter, Madhava, Vaikuntha — to rouse her."
 },
 {
  "n": 10,
  "title": "நோற்றுச் சுவர்க்கம்",
  "titleEn": "The Heavy Sleeper",
  "raga": "Thodi",
  "tamil": [
   "நோற்றுச் சுவர்க்கம் புகுகின்ற அம்மனாய்",
   "மாற்றமும் தாராரோ வாசல் திறவாதார்",
   "நாற்றத் துழாய்முடி நாராயணன் நம்மால்",
   "போற்றப் பறைதரும் புண்ணியனால் பண்டொருநாள்",
   "கூற்றத்தின் வாய்வீழ்ந்த கும்பகரணனும்",
   "தோற்றம் உனக்கே பெருந்துயில்தான் தந்தானோ",
   "ஆற்ற அனந்தல் உடையாய் அருங்கலமே",
   "தேற்றமாய் வந்து திறவேலோர் எம்பாவாய்"
  ],
  "translit": [
   "nooRRuch suvarkkam puguginRa ammanaay",
   "maaRRamum thaaraaroo vaasal thiRavaadhaar",
   "naaRRath thuzhaaymuTi naaraayaNan nammaal",
   "pooRRap paRaidharum puNNiyanaal paNTorunaaL",
   "kuuRRaththin vaayviizhndha kumbagaraNanum",
   "thooRRam unakkee perundhuyilthaan thandhaanoo",
   "aaRRa anandhal uTaiyaay arunggalamee",
   "theeRRamaay vandhu thiRaveeloor embaavaay"
  ],
  "meaning": "You promised to wake us first, yet you sleep on like Kumbhakarna! Open the door — we sing of Narayana crowned with fragrant tulasi, the meritorious one who will grant us the drum we seek."
 },
 {
  "n": 11,
  "title": "கற்றுக் கறவை",
  "titleEn": "The Golden Creeper",
  "raga": "Huseni",
  "tamil": [
   "கற்றுக் கறவைக் கணங்கள் பல கறந்து",
   "செற்றார் திறலழியச் சென்று செருச்செய்யும்",
   "குற்றம் ஒன்றில்லாத கோவலர் தம் பொற்கொடியே",
   "புற்றரவு அல்குல் புனமயிலே போதராய்",
   "சுற்றத்துத் தோழிமார் எல்லாரும் வந்து நின்",
   "முற்றம் புகுந்து முகில்வண்ணன் பேர்பாடச்",
   "சிற்றாதே பேசாதே செல்லப் பெண்டாட்டி நீ",
   "எற்றுக்கு உறங்கும் பொருள் ஏலோர் எம்பாவாய்"
  ],
  "translit": [
   "kaRRuk kaRavaik kaNanggaL pala kaRandhu",
   "seRRaar thiRalazhiyach senRu seruchcheyyum",
   "kuRRam onRillaadha koovalar tham poRkoTiyee",
   "puRRaravu alkul punamayilee poodharaay",
   "suRRaththuth thoozhimaar ellaarum vandhu nin",
   "muRRam pugundhu mugilvaNNan peerpaaTach",
   "siRRaadhee peesaadhee sellap peNTaaTTi nii",
   "eRRukku uRanggum poruL eeloor embaavaay"
  ],
  "meaning": "O faultless daughter of the cowherds, golden creeper, girl with hips like a coiled snake and the gait of a peacock! Your friends have all come into your courtyard to sing of the cloud-hued Lord — why do you sleep on, dear bride?"
 },
 {
  "n": 12,
  "title": "கனைத்திளங் கற்றெருமை",
  "titleEn": "The Buffalo Girl",
  "raga": "Kedaragowla",
  "tamil": [
   "கனைத்திளங் கற்றெருமை கன்றுக்கு இரங்கி",
   "நினைத்து முலைவழியே நின்று பால் சோர",
   "நனைத்தில்லம் சேறாக்கும் நற்செல்வன் தங்காய்",
   "பனித்தலை வீழ நின் வாசல் கடைபற்றி",
   "சினத்தினால் தென்னிலங்கைக் கோமானைச் செற்ற",
   "மனத்துக்கு இனியானைப் பாடவும் நீ வாய்திறவாய்",
   "இனித்தான் எழுந்திராய் ஈதென்ன பேருறக்கம்",
   "அனைத்தில்லத்தாரும் அறிந்து ஏலோர் எம்பாவாய்"
  ],
  "translit": [
   "kanaiththiLang kaRRerumai kanRukku iranggi",
   "ninaiththu mulaivazhiyee ninRu paal soora",
   "nanaiththillam seeRaakkum naRselvan thanggaay",
   "paniththalai viizha nin vaasal kaTaibaRRi",
   "sinaththinaal thennilanggaik koomaanaich seRRa",
   "manaththukku iniyaanaip paaTavum nii vaaythiRavaay",
   "iniththaan ezhundhiraay iidhenna peeruRakkam",
   "anaiththillaththaarum aRindhu eeloor embaavaay"
  ],
  "meaning": "The young buffaloes low for their calves and milk streams through the streets, yet you will not open your mouth to sing of Him who in anger destroyed Lanka's king. Wake from this great sleep — the whole street knows of it!"
 },
 {
  "n": 13,
  "title": "புள்ளின் வாய்",
  "titleEn": "To the Bathing Field",
  "raga": "Atana",
  "tamil": [
   "புள்ளின் வாய் கீண்டானைப் பொல்லா அரக்கனைக்",
   "கிள்ளிக் களைந்தானைக் கீர்த்திமை பாடிப்போய்ப்",
   "பிள்ளைகள் எல்லாரும் பாவைக் களம்புக்கார்",
   "வெள்ளி எழுந்து வியாழம் உறங்கிற்றுப்",
   "புள்ளும் சிலம்பின காண் போதரிக் கண்ணினாய்",
   "குள்ளக் குளிரக் குடைந்து நீராடாதே",
   "பள்ளிக் கிடத்தியோ பாவாய் நீ நன்னாளால்",
   "கள்ளம் தவிர்ந்து கலந்து ஏலோர் எம்பாவாய்"
  ],
  "translit": [
   "puLLin vaay kiiNTaanaip pollaa arakkanaik",
   "kiLLik kaLaindhaanaik kiirththimai paaTippooyp",
   "piLLaigaL ellaarum paavaik kaLambukkaar",
   "veLLi ezhundhu viyaazham uRanggiRRup",
   "puLLum silambina kaaN poodharik kaNNinaay",
   "kuLLak kuLirak kuTaindhu niiraaTaadhee",
   "paLLik kiTaththiyoo paavaay nii nannaaLaal",
   "kaLLam thavirndhu kalandhu eeloor embaavaay"
  ],
  "meaning": "Singing the fame of Him who tore the bird-demon's beak and destroyed the evil rakshasa, all the girls have gone to the bathing field. Venus has risen and Jupiter has set, the birds are singing — bathe in the cold water and join us, abandoning all deceit."
 },
 {
  "n": 14,
  "title": "உங்கள் புழைக்கடை",
  "titleEn": "The Backyard Pond",
  "raga": "Ananda Bhairavi",
  "tamil": [
   "உங்கள் புழைக்கடைத் தோட்டத்து வாவியுள்",
   "செங்கழுநீர் வாய் நெகிழ்ந்து ஆம்பல் வாய் கூம்பின காண்",
   "செங்கல் பொடிக்கூறை வெண்பல் தவத்தவர்",
